rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /User/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      // User private subcollections (FCM tokens, private settings)
      match /private/{privateDoc} {
        allow read, write: if isOwner(userId);
      }

      // User saved bookmarks
      match /Saved/{savedDoc} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explore / Posts collection
    match /Explore/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        (request.resource.data.uid == request.auth.uid || request.resource.data.Uid == request.auth.uid);
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && 
        (resource.data.uid == request.auth.uid || resource.data.Uid == request.auth.uid);
    }

    // Discussions collection
    match /Discussions/{discussionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && 
        (resource.data.uid == request.auth.uid || resource.data.Uid == request.auth.uid || resource.data.creatorId == request.auth.uid);
      
      // Replies subcollection
      match /Replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && 
          (resource.data.uid == request.auth.uid || resource.data.Uid == request.auth.uid);
      }
    }

    // Standalone Polls collection
    match /Polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // Application Secrets & Configuration (read-only for clients)
    match /Secrets/{secretId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only server/admin SDK can modify secrets
    }
  }
}
